# Copy to .env and fill in real values. Never commit .env.

# --- Core service ---
APP_NAME=trading-api
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0

# --- CORS: origins allowed to call this API directly from the browser
# (the Next.js dashboard in apps/web, a different origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Secrets at rest + auth (Phase 6) ---
# Generate BOTH with:  poetry run python -m app.cli generate-keys
# There are deliberately no defaults: an unset MASTER_ENCRYPTION_KEY makes
# storing exchange credentials fail loudly rather than silently writing
# plaintext, and a default JWT_SECRET_KEY would be a publicly-known
# signing key that anyone could forge admin tokens with.
MASTER_ENCRYPTION_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# false keeps the Phase 1-5 posture (unauthenticated API). With it false
# the API must not be exposed beyond a trusted network. See docs/AUTH.md.
AUTH_REQUIRED=false

# --- Trading mode: paper | shadow | live. NEVER default to live. ---
TRADING_MODE=paper

# --- Live-trading guardrails (Section 39) — all must be true for live orders ---
LIVE_TRADING=false
TRADING_CONFIRMATION=false
VALID_EXCHANGE_CREDENTIALS=false
RISK_LIMITS_VALID=false
EMERGENCY_STOP_AVAILABLE=true
MAX_LIVE_CAPITAL=1000
DISABLE_WITHDRAWALS=true

# --- Capital recovery / profit management ---
INITIAL_CAPITAL_RECOVERY_ENABLED=true
INITIAL_CAPITAL_RECOVERY_TARGET=1.00
MIN_PROFIT_BEFORE_CAPITAL_RECOVERY=0.15
PROFIT_POSITION_ENABLED=true
TRAILING_STOP_PERCENT=0.05
MIN_POSITION_VALUE=10.0
MAX_SLIPPAGE_PERCENT=0.01
TAKE_PROFIT_LEVELS=0.10,0.25,0.50

# --- Token risk ---
MAX_TOKEN_RISK_SCORE=60

# --- Copy trading ---
MIN_TRADER_SCORE=0.6
MAX_COPY_ALLOCATION_PER_TRADER=0.05
MAX_NUMBER_OF_COPIED_TRADERS=10
MAX_COPIED_POSITION_SIZE=0.01
MAX_TOTAL_COPY_EXPOSURE=0.20
MAX_COPY_PRICE_DEVIATION_PERCENT=0.03
MIN_CONSENSUS_DIFFERENCE=0.15

# --- Portfolio risk limits ---
MAX_DAILY_LOSS=0.05
MAX_WEEKLY_LOSS=0.12
MAX_DRAWDOWN=0.20
MAX_POSITION_SIZE=0.10
MAX_PORTFOLIO_EXPOSURE=0.80
MAX_ASSET_CONCENTRATION=0.25
MAX_COPY_TRADING_EXPOSURE=0.20
MAX_OPEN_POSITIONS=20
EMERGENCY_CLOSE_POSITIONS_ON_BREACH=false

# --- Data quality ---
MAX_DATA_AGE_MS=60000

# --- Notifications (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI provider ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_VERSION=unset
